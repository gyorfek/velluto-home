---
/**
 * €30 sample pack – the main conversion block.
 * Contents come from SAMPLE_PACK.items, so the list, the form summary and the
 * JSON-LD Offer always match.
 */
import Icon from './Icon.astro';
import { pathFor, type Lang } from '../i18n/config';
import { useTranslations, gsmUnit, priceLabel } from '../i18n';
import { SAMPLE_PACK, towelById, size } from '../data/products';
import { SAMPLE_IMG } from '../data/images';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const sampleHref = `${pathFor('contact', lang)}?sample=1#form`;
const items = SAMPLE_PACK.items.map(towelById);
const trustIcons = ['shield', 'truck', 'invoice'] as const;
---

<section id="sample" class="relative overflow-hidden bg-ink text-ivory" aria-labelledby="sample-title">
  <div class="container-luxe grid items-center gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
    <div class="relative lg:col-span-5">
      <div class="absolute -inset-3 border border-gold/40" aria-hidden="true"></div>
      <img
        src={SAMPLE_IMG.src}
        srcset={SAMPLE_IMG.srcset}
        sizes={SAMPLE_IMG.sizes}
        width="1400"
        height="1100"
        alt={t.sample.imageAlt}
        loading="lazy"
        decoding="async"
        class="relative w-full"
      />
      <p
        class="absolute -top-6 -right-2 flex h-24 w-24 flex-col items-center justify-center rounded-full bg-gold text-ink shadow-xl sm:-right-6"
      >
        <span class="font-serif text-3xl leading-none">{priceLabel(SAMPLE_PACK.price, lang)}</span>
      </p>
    </div>

    <div class="lg:col-span-7">
      <p class="eyebrow text-gold">{t.sample.eyebrow}</p>
      <h2 id="sample-title" class="mt-5 text-4xl leading-tight sm:text-5xl">{t.sample.title}</h2>
      <p class="mt-5 font-serif text-xl text-gold italic sm:text-2xl">{t.sample.price}</p>
      <p class="mt-6 max-w-2xl leading-relaxed text-ivory/70">{t.sample.lead}</p>

      <h3 class="mt-10 font-sans text-[0.7rem] font-semibold tracking-[0.22em] text-ivory/50 uppercase">
        {t.sample.contentsTitle}
      </h3>
      <ul class="mt-4 grid gap-px overflow-hidden bg-ivory/10 sm:grid-cols-2">
        {
          items.map((towel) => (
            <li class="flex items-center gap-4 bg-ink p-5">
              <Icon name={towel.id === 'mat' ? 'mat' : towel.id === 'guest' ? 'towelSmall' : 'towel'} class="h-8 w-8 shrink-0 text-gold" />
              <div>
                <p class="text-sm font-semibold text-ivory">1 × {t.towels.items[towel.id].name}</p>
                <p class="mt-0.5 text-xs tracking-wide text-ivory/55">
                  {size(towel)} cm · {towel.gsm} {gsmUnit(lang)}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={sampleHref} class="btn btn-gold">
          {t.sample.cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <p class="text-xs text-ivory/50">{t.sample.fine}</p>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-ivory/10 pt-6">
        {
          t.sample.trust.map((item, i) => (
            <li class="flex items-center gap-2.5 text-xs tracking-wide text-ivory/75">
              <Icon name={trustIcons[i]} class="h-5 w-5 text-gold" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
