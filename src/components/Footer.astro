---
import Flag from './Flag.astro';
import { LANGS, LANG_META, pathFor, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n';
import { SITE, TOWN } from '../data/site';
import { MANUFACTURER } from '../data/products';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-ivory/70">
  <div class="container-luxe grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:py-20">
    <div>
      <p class="font-serif text-2xl tracking-[0.18em] text-ivory">VELLUTO</p>
      <p class="mt-1 flex items-center gap-2 text-[0.55rem] font-semibold tracking-[0.5em] text-gold">
        <span class="h-px w-5 bg-gold"></span>HOME
      </p>
      <p class="mt-6 max-w-xs text-sm leading-relaxed">{t.footer.tagline}</p>
    </div>

    <div>
      <p class="eyebrow text-gold">{t.footer.contact}</p>
      <address class="mt-5 space-y-2 text-sm leading-relaxed not-italic">
        <a href={`mailto:${SITE.email}`} class="block text-ivory transition hover:text-gold">{SITE.email}</a>
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="block transition hover:text-gold">{SITE.phone}</a>
        <span class="block pt-2">
          {SITE.address.street}<br />
          {SITE.address.postalCode}
          {TOWN[lang]}, {SITE.address.region}<br />
          {t.footer.country} · EU
        </span>
      </address>
    </div>

    <div>
      <p class="eyebrow text-gold">{t.footer.imprint}</p>
      <dl class="mt-5 space-y-1.5 text-sm">
        <div><dt class="inline">{t.footer.company}:</dt> <dd class="inline">{SITE.legalName}</dd></div>
        <div><dt class="inline">{t.footer.regNo}:</dt> <dd class="inline">{SITE.regNo}</dd></div>
        <div><dt class="inline">{t.footer.vatNo}:</dt> <dd class="inline">{SITE.vatId}</dd></div>
        <div class="pt-3">
          <dt class="inline">{t.footer.manufacturer}:</dt>
          <dd class="inline">{MANUFACTURER.name}, {MANUFACTURER.location}</dd>
        </div>
      </dl>
    </div>

    <div>
      <p class="eyebrow text-gold">{t.footer.languages}</p>
      <ul class="mt-5 space-y-2 text-sm">
        {
          LANGS.map((l) => (
            <li>
              <a
                href={pathFor('home', l)}
                hreflang={l}
                lang={l}
                class:list={['inline-flex items-center gap-2.5 transition hover:text-gold', l === lang && 'text-ivory']}
              >
                <Flag lang={l} uid="ft" class="h-3 w-[18px]" />
                {LANG_META[l].name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-ivory/10">
    <p class="container-luxe py-6 text-xs text-ivory/45">
      © {year} {SITE.brand}. {t.footer.rights}
    </p>
  </div>
</footer>
