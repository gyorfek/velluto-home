---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const icons = ['loom', 'shield', 'cotton', 'truck'] as const;
---

<section class="border-y border-ink/[0.07] bg-ivory" aria-labelledby="usp-title">
  <h2 id="usp-title" class="sr-only">{t.usp.title}</h2>
  <ul class="container-luxe grid divide-ink/[0.07] sm:grid-cols-2 lg:grid-cols-4 lg:divide-x">
    {
      t.usp.items.map((item, i) => (
        <li class="flex gap-4 py-7 lg:px-7 lg:first:pl-0 lg:last:pr-0">
          <Icon name={icons[i]} class="mt-0.5 h-7 w-7 shrink-0 text-gold" />
          <div>
            <h3 class="font-sans text-[0.78rem] font-bold tracking-[0.08em] text-ink uppercase">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/60">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
