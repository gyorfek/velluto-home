---
/** Thin-line icon set (1.25px stroke, currentColor). */
interface Props {
  name: 'loom' | 'shield' | 'cotton' | 'truck' | 'check' | 'towel' | 'towelSmall' | 'mat' | 'invoice' | 'arrow' | 'box' | 'mail' | 'pin';
  class?: string;
}
const { name, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'loom' && (
      <>
        <path d="M3 21V8l5 3V8l5 3V8l5 3V4h3v17z" />
        <path d="M7 17h2M12 17h2M17 17h1" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z" />
        <path d="M9 12l2 2 4-4" />
      </>
    )
  }
  {
    name === 'cotton' && (
      <>
        <circle cx="12" cy="8" r="3" />
        <circle cx="8" cy="12" r="3" />
        <circle cx="16" cy="12" r="3" />
        <path d="M12 15v6M9 21h6" />
      </>
    )
  }
  {
    name === 'truck' && (
      <>
        <path d="M2 6h12v10H2zM14 10h4l3 3v3h-7" />
        <circle cx="6" cy="18" r="1.8" />
        <circle cx="17" cy="18" r="1.8" />
      </>
    )
  }
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {
    name === 'towel' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path d="M7 5v14M8.5 5v14" />
      </>
    )
  }
  {
    name === 'towelSmall' && (
      <>
        <rect x="6" y="6" width="12" height="12" rx="1.5" />
        <path d="M9 6v12M10.3 6v12" />
      </>
    )
  }
  {
    name === 'mat' && (
      <>
        <rect x="3" y="7" width="18" height="10" rx="2" />
        <path d="M6 10h12M6 12h12M6 14h12" stroke-dasharray="1 2" />
      </>
    )
  }
  {
    name === 'invoice' && (
      <>
        <path d="M6 3h9l3 3v15H6z" />
        <path d="M9 9h6M9 12h6M9 15h4" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'box' && (
      <>
        <path d="M3 8l9-4 9 4v9l-9 4-9-4z" />
        <path d="M3 8l9 4 9-4M12 12v9" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path d="M3 7l9 6 9-6" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6-5.5-6-11a6 6 0 0112 0c0 5.5-6 11-6 11z" />
        <circle cx="12" cy="10" r="2" />
      </>
    )
  }
</svg>
