---
/**
 * Localized sub-pages: /hu/kapcsolat/, /de/kontakt/, /it/grazie/ …
 * Slugs come from ROUTES in src/i18n/config.ts.
 */
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { pathFor, slugPaths, type Lang, type RouteKey } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { SITE, TOWN } from '../../data/site';
import { MANUFACTURER } from '../../data/products';

export function getStaticPaths() {
  return slugPaths();
}

const lang = Astro.params.lang as Lang;
const { route } = Astro.props as { route: Exclude<RouteKey, 'home'> };
const t = useTranslations(lang);
const home = { name: t.breadcrumb.home, path: pathFor('home', lang) };
const meta = t.meta[route];
const crumbName = route === 'contact' ? t.nav.contact : t.thanks.title;
---

<Base
  lang={lang}
  route={route}
  title={meta.title}
  description={meta.description}
  breadcrumbs={[home, { name: crumbName, path: pathFor(route, lang) }]}
>
  {
    route === 'contact' && (
      <>
        <section class="bg-beige">
          <div class="container-luxe py-14 sm:py-20">
            <nav aria-label="Breadcrumb" class="text-xs tracking-wide text-taupe">
              <a href={home.path} class="hover:text-ink">
                {home.name}
              </a>
              <span class="mx-2">/</span>
              <span aria-current="page">{t.nav.contact}</span>
            </nav>
            <p class="eyebrow mt-8">{t.contact.eyebrow}</p>
            <h1 class="mt-5 text-5xl leading-tight sm:text-6xl">{t.contact.title}</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/65">{t.contact.lead}</p>
          </div>
        </section>

        <section class="container-luxe grid gap-16 py-16 lg:grid-cols-12 lg:py-24">
          <div class="lg:col-span-8">
            <ContactForm lang={lang} />
          </div>

          <aside class="space-y-10 lg:col-span-4 lg:border-l lg:border-ink/10 lg:pl-12">
            <div>
              <Icon name="mail" class="h-7 w-7 text-gold" />
              <h2 class="mt-4 text-2xl">{t.contact.asideTitle}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">{t.contact.asideText}</p>
              <a
                href={`mailto:${SITE.email}`}
                class="mt-4 inline-block font-semibold text-ink underline decoration-gold underline-offset-4"
              >
                {SITE.email}
              </a>
            </div>
            <div>
              <Icon name="pin" class="h-7 w-7 text-gold" />
              <h2 class="mt-4 text-2xl">{t.contact.asideDispatch}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">
                {SITE.brand}
                <br />
                {SITE.address.street}
                <br />
                {SITE.address.postalCode} {TOWN[lang]}, {SITE.address.region}
                <br />
                {t.footer.country} · EU
              </p>
            </div>
            <div>
              <Icon name="loom" class="h-7 w-7 text-gold" />
              <h2 class="mt-4 text-2xl">{t.footer.manufacturer}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">
                {MANUFACTURER.name}, {MANUFACTURER.location}
                <br />
                OEKO-TEX® Standard 100 · {t.towels.material}
              </p>
            </div>
          </aside>
        </section>
      </>
    )
  }

  {
    route === 'thanks' && (
      <section class="bg-beige">
        <div class="container-luxe max-w-3xl py-20 text-center sm:py-28">
          <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-gold text-gold">
            <Icon name="check" class="h-8 w-8" />
          </span>
          {/* One H1 only: its text switches to sampleTitle for ?sample=1 (see script below) */}
          <h1 id="thanks-title" data-sample-title={t.thanks.sampleTitle} class="mt-8 text-4xl leading-tight sm:text-5xl">
            {t.thanks.title}
          </h1>

          {/* General enquiry */}
          <p id="thanks-general" class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink/65">
            {t.thanks.lead}
          </p>

          {/* Sample pack request: personal note from Enikő */}
          <div id="thanks-sample" class="mx-auto mt-10 hidden max-w-xl bg-ivory p-8 text-left shadow-sm sm:p-12">
            <span class="block h-px w-12 bg-gold" aria-hidden="true"></span>
            <p class="mt-6 text-lg leading-relaxed text-ink/75">{t.thanks.sampleMessage}</p>
            <p class="mt-8">
              <span class="block font-serif text-3xl text-ink italic">– {t.thanks.signatureName}</span>
              <span class="mt-1 block text-[0.7rem] font-semibold tracking-[0.22em] text-gold-dark uppercase">
                {t.thanks.signatureCompany}
              </span>
            </p>
          </div>

          <div class="mt-14 flex flex-col justify-center gap-4 sm:flex-row">
            <a href={pathFor('home', lang)} class="btn btn-primary">
              {t.thanks.back}
            </a>
            <a href={`${pathFor('home', lang)}#towels`} class="btn btn-ghost">
              {t.thanks.collection}
            </a>
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Thank-you page: after a sample pack request (?sample=1) show Enikő's note instead of the general text.
  const sampleNote = document.getElementById('thanks-sample');
  if (sampleNote && new URLSearchParams(location.search).get('sample') === '1') {
    const h1 = document.getElementById('thanks-title');
    if (h1?.dataset.sampleTitle) h1.textContent = h1.dataset.sampleTitle;
    document.getElementById('thanks-general')?.classList.add('hidden');
    sampleNote.classList.remove('hidden');
  }
</script>
